{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pokemon30-collection",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // Dominio propio (asignado también desde el panel de Cloudflare)
  "routes": [{ "pattern": "pokemon30.diemo.dev", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*", "/img/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pokemon30",
      "database_id": "e9cebb9a-719d-4be0-91f8-fe06cfc7dc19",
      "migrations_dir": "migrations"
    }
  ],
  // Copia propia de todas las imágenes de cartas
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "pokemon30-images" }],
  // 06:17 → sincroniza con TCGdex. Cada hora → precarga/comprueba imágenes pendientes
  "triggers": { "crons": ["17 6 * * *", "41 * * * *"] },
  "vars": {
    "APP_NAME": "Pokémon 30",
    // Ids extra de TCGdex a sincronizar además de los que contengan "30" + "aniversario" en el nombre
    "SYNC_EXTRA_SETS": ""
  },
  "observability": { "enabled": true }
}
