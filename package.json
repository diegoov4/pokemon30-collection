{
  "name": "pokemon30",
  "version": "1.0.0",
  "description": "Colección compartida de cartas Pokémon 30.º aniversario (Cloudflare Worker)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p .",
    "db:migrate": "wrangler d1 migrations apply pokemon30 --remote",
    "db:migrate:local": "wrangler d1 migrations apply pokemon30 --local",
    "seed": "node scripts/build-seed.mjs",
    "check:images": "node scripts/check-images.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261004.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.147.0"
  },
  "private": true
}
